# Sin configuración, la aplicación trabaja en modo borrador y no envía datos.
# Para esta instalación local, copiar los valores necesarios a work/.env.
BIBLIOTECA_AI_PROVIDER=draft

# OpenAI:
# BIBLIOTECA_AI_PROVIDER=openai
# BIBLIOTECA_AI_API_KEY=
# BIBLIOTECA_AI_MODEL=gpt-5-mini
# BIBLIOTECA_AI_BASE_URL=https://api.openai.com/v1

# DeepSeek:
# BIBLIOTECA_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# BIBLIOTECA_AI_MODEL=deepseek-v4-flash
# BIBLIOTECA_AI_BASE_URL=https://api.deepseek.com

# OpenClaw (habilitar gateway.http.endpoints.responses.enabled):
# BIBLIOTECA_AI_PROVIDER=openclaw
# BIBLIOTECA_AI_API_KEY=
# BIBLIOTECA_AI_MODEL=openclaw
# BIBLIOTECA_AI_BASE_URL=http://127.0.0.1:18789/v1
# Token exclusivo para que el agente local entregue paquetes al servidor.
# Debe ser largo, aleatorio y diferente de cualquier clave de IA.
BIBLIOTECA_SYNC_TOKEN=
BIBLIOTECA_SYNC_MAX_BYTES=33554432
BIBLIOTECA_SERVER_URL=https://biblioteca.example.com
KINDLE_TIMEZONE=America/Argentina/Buenos_Aires
