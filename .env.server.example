# Generar un secreto largo y diferente de las credenciales de OpenClaw o de la IA.
BIBLIOTECA_SYNC_TOKEN=
BIBLIOTECA_SYNC_MAX_BYTES=33554432

# Integración de IA: mantener en draft hasta configurar OpenClaw deliberadamente.
BIBLIOTECA_AI_PROVIDER=draft

# Ejemplo futuro para OpenClaw, accesible solo por la red privada del servidor.
# BIBLIOTECA_AI_PROVIDER=openclaw
# BIBLIOTECA_AI_API_KEY=
# BIBLIOTECA_AI_MODEL=openclaw
# BIBLIOTECA_AI_BASE_URL=http://127.0.0.1:18789/v1
